---
import BaseHead from '../../components/BaseHead';
import Footer from '../../components/Footer';
import Header from '../../components/Header';
import { getSiteDescription, getSiteTitle } from '../../consts';
import { languages, type Language } from '../../i18n/ui';

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const siteTitle = getSiteTitle(lang);
const siteDescription = getSiteDescription(lang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead
			title={`Curriculo | ${siteTitle}`}
			description={siteDescription}
			lang={lang}
			currentUrl={Astro.url.toString()}
			pathname={Astro.url.pathname}
			siteUrl={Astro.site?.toString() ?? Astro.url.origin}
			generator={Astro.generator}
		/>
	</head>
	<body>
		<Header lang={lang} currentPath={Astro.url.pathname} siteTitle={siteTitle} />
		<main>
			<h1>Curriculo</h1>
			<p>Conteúdo em breve.</p>
		</main>
		<Footer lang={lang} />
	</body>
</html>
