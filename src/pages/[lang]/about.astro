---
import AboutHeroImage from "../../assets/blog-placeholder-about.jpg";
import Layout from "../../layouts/BlogPost.astro";
import { languages, useTranslations, type Language } from "../../i18n/ui";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const t = useTranslations(lang);
const aboutBody = t("about.body");
const principles = t("about.principles");
---

<Layout
  title={t("about.title")}
  description={t("about.description")}

  lang={lang}
>
  {aboutBody.map((paragraph) => (
    <p>{paragraph}</p>
  ))}
  <h4>{t("about.workTitle")}</h4>
  <ul>
    {principles.map(({ title, description }) => (
      <li>
        <strong>{title}:</strong> {description}
      </li>
    ))}
  </ul>
</Layout>
