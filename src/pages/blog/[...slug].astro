---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import {
  findPostByCanonicalSlug,
  getCanonicalSlug,
  getPostLanguage,
} from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getCollection(
    "blog",
    (post) => getPostLanguage(post) === "en" && !post.data.draft,
  );
  return posts.map((post) => ({
    params: { slug: getCanonicalSlug(post) },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;

const allPosts = await getCollection("blog");
const requestedSlug = Astro.params.slug ?? "";
const post =
  findPostByCanonicalSlug(allPosts, "en", requestedSlug) ?? Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} lang="en">
  <Content />
</BlogPost>
